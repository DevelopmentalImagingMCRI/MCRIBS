DLHWM = scipy.ndimage.distance_transform_edt(RegionsIMG != 3)
DRHWM = scipy.ndimage.distance_transform_edt(RegionsIMG != 2)

NewRegionsIMG = numpy.array(RegionsIMG).squeeze()
NewRegionsIMG[Utils.ismember(NewRegionsIMG, [2, 3])] = 0

#%DilatedWMMask[MaskToRemove] = True

NewRegionsIMG[numpy.logical_and(DilatedWMMask, DLHWM < DRHWM)] = 3
