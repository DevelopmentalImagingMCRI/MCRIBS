LabelFusionIMG = numpy.int16(LabelFusionNII.dataobj).squeeze()

KMeans5NII = nibabel.load(os.path.join('SurfReconDeformable', subjID, 'temp', subjID + "_t2w_restore_brain_dn_kmeans5.nii.gz"))
