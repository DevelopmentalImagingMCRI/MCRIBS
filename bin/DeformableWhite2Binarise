os.unlink(os.path.join('SurfReconDeformable', subjID, 'temp', subjID + "_labelfusion_dkt_edited.nii.gz"))

WMForceSecondIMG = numpy.single(Utils.ismember(LabelFusionIMG, [254, 255])) * -1
WMForceSecondIMG[Utils.ismember(LabelFusionIMG, [998, 999])] = 1

WMForceSecondIMG[DilatedWMMask] = -1

# voxels that are Kmeans = 3, DrawEM = WM, LabelFusion cortex or WM, set to -1
# LabelFusionWMGM =   numpy.logical_or(Utils.ismember(LabelFusionIMG, [2, 41, 255, 254]),
