# DrawEMNII = nibabel.load(os.path.join('SurfReconDeformable', subjID, 'temp', subjID + "_drawem_alberts_tissueseg.nii.gz"))
# DrawEMIMG = numpy.uint8(DrawEMNII.dataobj).squeeze()

subjID + "_drawem_alberts_tissueseg.nii.gz"

# make a new regions.nii.gz
