RegionsIMG = numpy.uint8(RegionsNII.dataobj).squeeze()

White2Surf = VTPUtils.readVTPSurf(os.path.join('SurfReconDeformable', subjID, 'temp', 'white-2.vtp'))

White2Mask = surfFillNII(T2NII, White2Surf)

White2Ribbon = numpy.zeros(T2NII.shape[0:3], dtype=numpy.bool_)
White2Ribbon[White2Mask] = True

# remove all non-WM structures
WMMask = numpy.array(White2Ribbon).squeeze()

MaskToRemove = Utils.ismember(LabelFusionIMG, [4, 9, 28, 11, 12, 13, 17, 31, 18, 26, 900, 51, 52, 43, 50, 60, 48, 54, 63, 53, 58, 901, 14, 15, 28, 60])
WMMask[MaskToRemove] = False

WMMean = numpy.mean(T2IMG[WMMask])
GMMean = numpy.mean(T2IMG[RegionsIMG == 1])
#GMStd = numpy.std(T2IMG[RegionsIMG == 1])

BrightT2 = T2IMG > WMMean
#LabelFusionIMGWMMask = Utils.ismember(LabelFusionIMG, [2, 41])

BarrierMask = numpy.logical_and(Utils.ismember(LabelFusionIMG, [254, 255, 2, 41]), BrightT2)
DilatedWMMask = numpy.array(WMMask)
for z in range(5):
    DilatedWMMask = numpy.logical_and(numpy.logical_or(BarrierMask, DilatedWMMask), scipy.ndimage.binary_dilation(DilatedWMMask))
    
outNII = nibabel.Nifti1Image(numpy.uint8(White2Ribbon), T2NII.affine)
nibabel.save(outNII, os.path.join('SurfReconDeformable', subjID, 'temp', 'white-2_mask.nii.gz'))

outNII = nibabel.Nifti1Image(numpy.uint8(WMMask), T2NII.affine)
nibabel.save(outNII, os.path.join('SurfReconDeformable', subjID, 'temp', 'white-2_wmmask.nii.gz'))

outNII = nibabel.Nifti1Image(numpy.uint8(DilatedWMMask), T2NII.affine)
nibabel.save(outNII, os.path.join('SurfReconDeformable', subjID, 'temp', 'white-2_dwmmask.nii.gz'))

outNII = nibabel.Nifti1Image(numpy.uint8(BrightT2), T2NII.affine)
nibabel.save(outNII, os.path.join('SurfReconDeformable', subjID, 'temp', 'bright_t2.nii.gz'))

# run N4 with heavy corrections
