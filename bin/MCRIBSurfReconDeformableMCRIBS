#!/bin/bash

export SUBJECTS_DIR=`pwd`/freesurfer

if [ -z "$1" ]
then
	echo "Usage $0 <subjid> [options]"
	exit
fi

ENSUREPIAL=-ensure-pial-is-outside-white-surface
LARGECLOSE=
USEFASTCOLLISION=
JOINTHRESHOLD=1
LARGEVENTRICLES=
NOWMLAPLACIANEXPAND=
DEBUGWHITE=
DEBUGPIAL=
DEBUGCEREBRUM=
DEBUGNNC=
CLEANSR=
CLEANPIAL=

while (( "$#" ))
do
	case $1 in
		--noensureoutsidepial)
			ENSUREPIAL=
		;;
		--largeclose)
			LARGECLOSE=YES
		;;
		--fastcollision)
			USEFASTCOLLISION=-use-fast-collision
		;;
		--largeventricles)
			LARGEVENTRICLES=-l
		;;
		--nowmlaplacianexpand)
			NOWMLAPLACIANEXPAND=--nowmlaplacianexpand
		;;
		--cleansr)
			CLEANSR=YES
		;;
		--cleanpial)
			CLEANPIAL=YES
		;;

		--debugcerebrum)
			DEBUGCEREBRUM="--debugcerebrum"
		;;
		--debugwhite)
			DEBUGWHITE="--debugwhite"
		;;
		--debugpial)
			DEBUGPIAL="--debugpial"
		;;
		--jointhreshold)
			JOINTHRESHOLD=$2
		shift;
		;;
		*)
			SUBJID=$1
		;;
	esac
	shift;
done

if [ "$CLEANSR" == "YES" ]
then
	rm -fr SurfReconDeformable/${SUBJID}
fi

if [ "$CLEANPIAL" == "YES" ]
then
	find SurfReconDeformable/${SUBJID} -name "pial*" -delete
fi

if [ "$LARGECLOSE" == "YES" ]
then
	CONFIGFILE=`dirname $0`/../lib/Deformable/recon-neonatal-cortex-large.cfg
else
	CONFIGFILE=`dirname $0`/../lib/Deformable/recon-neonatal-cortex.cfg
fi
#echo noensure $NOENSURE
#echo largeclose $LARGECLOSE
#exit
GMMATCH=
for j in `seq 1000 1035`
do
	GMMATCH="$GMMATCH $j `expr $j + 1000`"
done


export TISSUESEGDIR=TissueSegMCRIBS
export OUTPUTPREFIX=${TISSUESEGDIR}/${SUBJID}/${SUBJID}

if [ ! -f "${OUTPUTPREFIX}_labelfusion_dkt_edited.nii.gz" ]
then
	cp ${OUTPUTPREFIX}_labelfusion_dkt.nii.gz ${OUTPUTPREFIX}_labelfusion_dkt_edited.nii.gz
fi
export TEMPLATEREGSUFFIX=skullstrip_reg
#RemoveDarkWMFromGMSegmentation $SUBJID
mkdir -p TissueSeg
P=`pwd`
T=`mktemp -d`


#MakeKMeans34Class $SUBJID
#MakeGMSegmentation $SUBJID
#exit
#PostProcessDKTLabelFusion $LARGEVENTRICLES $NOWMLAPLACIANEXPAND $SUBJID
if [ ! -f "SurfReconDeformable/${SUBJID}/temp/first_run_done" ]
then
	PostProcessDKTLabelFusion $LARGEVENTRICLES $SUBJID
	#PostProcessDKTLabelFusionDarkWMNearCuneus $SUBJID

	MakeRegionsBSCutting $SUBJID

	#rm -f ${OUTPUTPREFIX}_majority_dkt_compositereg_ribbon_midlinefill.nii.gz ${OUTPUTPREFIX}_majority_dkt_compositereg_ribbon.nii.gz
	FSToDrawEMLabels $TISSUESEGDIR/${SUBJID}/${SUBJID}_labelfusion_regions.nii.gz TissueSeg/${SUBJID}_all_labels_manedit.nii.gz
	#cp $TISSUESEGDIR/${SUBJID}/${SUBJID}_t2w_restore.nii.gz TissueSeg/${SUBJID}_t2w_restore.nii.gz
	#cp $TISSUESEGDIR/${SUBJID}/${SUBJID}_brain_mask.nii.gz TissueSeg/${SUBJID}_brain_mask.nii.gz
	fslmaths $TISSUESEGDIR/${SUBJID}/${SUBJID}_t2w_restore_brain_dn_atropos3_priors_segmentation -bin TissueSeg/${SUBJID}_brain_mask -odt char

	mkdir -p freesurfer/${SUBJID}/mri
	mkdir -p SurfReconDeformable/${SUBJID}/temp SurfReconDeformable/${SUBJID}/meshes SurfReconDeformable/${SUBJID}/recon


	############################## MakeWMForce #################################

	MakeWMPialForceImages $SUBJID

	############################## MakeWMForce #################################
	MRIBinarize --i ${OUTPUTPREFIX}_labelfusion_regions_brainstem_cut.nii.gz --o ${OUTPUTPREFIX}_labelfusion_regions_brainstem_cut_mask.nii.gz --min 1 --dilate 1

	W=`fslstats ${OUTPUTPREFIX}_labelfusion_regions_brainstem_cut_mask -w`

	if [ -f "SurfReconDeformable/${SUBJID}/recon/regions_manual.nii.gz" ]
	then
		cp SurfReconDeformable/${SUBJID}/recon/regions_manual.nii.gz SurfReconDeformable/${SUBJID}/recon/regions.nii.gz
	else
	    # Does cropping cause issues later on??
		fslroi ${OUTPUTPREFIX}_labelfusion_regions_brainstem_cut SurfReconDeformable/${SUBJID}/recon/regions $W
		#imcp ${OUTPUTPREFIX}_labelfusion_regions_brainstem_cut SurfReconDeformable/${SUBJID}/recon/regions
	fi

	mri_binarize --i ${OUTPUTPREFIX}_labelfusion_dkt_edited.nii.gz --o ${OUTPUTPREFIX}_labelfusion_dkt_edited_wm.nii.gz --match 2 41 254 255

	fslroi ${OUTPUTPREFIX}_t2w_restore_cerebellum_blacked SurfReconDeformable/${SUBJID}/temp/t2w-image-cerebellum-blacked $W
	fslroi ${OUTPUTPREFIX}_labelfusion_corticalhulldmap SurfReconDeformable/${SUBJID}/recon/cortical-hull-dmap $W
	fslroi ${OUTPUTPREFIX}_labelfusion_dkt_edited_wm SurfReconDeformable/${SUBJID}/temp/white-matter-mask $W

	fslroi SurfReconDeformable/${SUBJID}/temp/wm_force SurfReconDeformable/${SUBJID}/temp/wm_force $W
	# disabling cropping to see if it is the cause of problems
	# if this makes the problem go away then consider dilating the cut mask before cropping to reduce the image size a bit
	# imcp ${OUTPUTPREFIX}_t2w_restore_cerebellum_blacked SurfReconDeformable/${SUBJID}/temp/t2w-image-cerebellum-blacked
	# imcp ${OUTPUTPREFIX}_labelfusion_corticalhulldmap SurfReconDeformable/${SUBJID}/recon/cortical-hull-dmap
	# imcp ${OUTPUTPREFIX}_labelfusion_dkt_edited_wm SurfReconDeformable/${SUBJID}/temp/white-matter-mask

	# imcp SurfReconDeformable/${SUBJID}/temp/wm_force SurfReconDeformable/${SUBJID}/temp/wm_force


	#fslroi SurfReconDeformable/${SUBJID}/temp/wm_force_second SurfReconDeformable/${SUBJID}/temp/wm_force_second $W
	rm -f ${OUTPUTPREFIX}_labelfusion_regions_brainstem_cut_mask.nii.gz ${OUTPUTPREFIX}_labelfusion_corticalhulldmap.nii.gz ${OUTPUTPREFIX}_labelfusion_regions_brainstem_cut.nii.gz

	GMREPLACE=
	for j in `seq 1000 1035`
	do
		GMREPLACE="$GMREPLACE --replace $j 3"
		GMREPLACE="$GMREPLACE --replace `expr $j + 1000` 42"
	done
	MRIBinarize --i $TISSUESEGDIR/${SUBJID}/${SUBJID}_labelfusion_dkt.nii.gz --o freesurfer/${SUBJID}/mri/aseg.presurf.mgz $GMREPLACE
	mri_mask $TISSUESEGDIR/${SUBJID}/${SUBJID}_t2w_restore.nii.gz $TISSUESEGDIR/${SUBJID}/${SUBJID}_brain_mask.nii.gz freesurfer/${SUBJID}/mri/brainmask.mgz

	#if [ ! -f "freesurfer/${SUBJID}/mri/norm.mgz" ]
	#then
	mri_convert TissueSegMCRIBS/$SUBJID/${SUBJID}_t2w_restore.nii.gz freesurfer/${SUBJID}/mri/norm.mgz
fi
#exit
NUMPROC=`nproc`
NUMTHREADS=`expr $NUMPROC / 2`
#NUMTHREADS=`expr $NUMPROC`
NUMTHREADS=`nproc`
#NUMTHREADS=3
export VTK_MAX_THREADS=$NUMTHREADS
#CRIBReconAll --surfrecon $NOENSURE $LARGECLOSE -openmp $NUMTHREADS ${SUBJID}
rm -f SurfReconDeformable/${SUBJID}/temp/white-5* SurfReconDeformable/${SUBJID}/temp/white-6*
rm -f ${OUTPUTPREFIX}_labelfusion_dkt_edited_wm.nii.gz

if [ ! -f "SurfReconDeformable/${SUBJID}/temp/first_run_done" ]
then
    echo $LD_LIBRARY_PATH
	recon-neonatal-cortex -r `pwd` -c $CONFIGFILE -s $SUBJID -t $OMP_NUM_THREADS -v -v -v -v -d -d -d -f $ENSUREPIAL -j $JOINTHRESHOLD $USEFASTCOLLISION $DEBUGCEREBRUM $DEBUGWHITE $DEBUGPIAL 2>&1 | tee -a logs/$SUBJID.log
	
# else
# 	# temporary 
# 	mri_convert -rl SurfReconDeformable/${SUBJID}/recon/regions.nii.gz -rt nearest -ns 1 -odt int ${OUTPUTPREFIX}_labelfusion_dkt_edited.nii.gz SurfReconDeformable/${SUBJID}/recon/labelfusion_dkt_edited.nii.gz
# 	mri_binarize --i SurfReconDeformable/${SUBJID}/recon/labelfusion_dkt_edited.nii.gz --o SurfReconDeformable/${SUBJID}/recon/labelfusion_dkt_edited_4thvent.nii.gz --match 15 --binval 15
# 	mri_mask -transfer 15 SurfReconDeformable/${SUBJID}/recon/regions.nii.gz SurfReconDeformable/${SUBJID}/recon/labelfusion_dkt_edited_4thvent.nii.gz SurfReconDeformable/${SUBJID}/recon/regions.nii.gz
# 	mri_binarize --i SurfReconDeformable/${SUBJID}/recon/regions.nii.gz --o SurfReconDeformable/${SUBJID}/recon/regions.nii.gz --replace 15 4
# 	# second run, refinement of the WM surface
# 	recon-neonatal-cortex -r `pwd` -c $CONFIGFILE -s $SUBJID -t $OMP_NUM_THREADS -v -v -v -v -d -d -f $ENSUREPIAL -j $JOINTHRESHOLD $USEFASTCOLLISION $DEBUGWHITE $DEBUGPIAL 2>&1 | tee -a logs/$SUBJID.log
fi

# mri_binarize --i ${OUTPUTPREFIX}_labelfusion_dkt_edited.nii.gz --o ${OUTPUTPREFIX}_wm_closed.nii.gz --match 2 41 254 255 --dilate 1 --erode 1

# N4BiasFieldCorrection -d 3 -i ${OUTPUTPREFIX}_t2w_restore.nii.gz -x ${OUTPUTPREFIX}_brain_mask.nii.gz -w ${OUTPUTPREFIX}_wm_closed.nii.gz -s 2 -b [26,3] -v -o ${OUTPUTPREFIX}_wm_corrected.nii.gz

# mri_convert -rl SurfReconDeformable/${SUBJID}/recon/regions.nii.gz -ns 1 -odt float ${OUTPUTPREFIX}_wm_corrected.nii.gz SurfReconDeformable/${SUBJID}/temp/t2w-image-wmcorrected.nii.gz

# first_run_done is created by recon-neonatal-cortex
if [ ! -f "SurfReconDeformable/${SUBJID}/temp/first_run_done" ]
then
	echo "Error occured in first run"
	exit
fi

MakePialForceSecond $SUBJID

recon-neonatal-cortex -r `pwd` -c $CONFIGFILE -s $SUBJID -t $OMP_NUM_THREADS -v -v -v -v  -f $ENSUREPIAL -j $JOINTHRESHOLD $USEFASTCOLLISION $DEBUGCEREBRUM $DEBUGWHITE $DEBUGPIAL -d -d -d 2>&1 | tee -a logs/$SUBJID.log

if [ -f "SurfReconDeformable/${SUBJID}/temp/white_rerun_required" ]
then
	echo "White rerun required, rerunning"
	rm -f SurfReconDeformable/${SUBJID}/temp/white_rerun_required
	touch SurfReconDeformable/${SUBJID}/temp/white_second_run
	recon-neonatal-cortex -r `pwd` -c $CONFIGFILE -s $SUBJID -t $OMP_NUM_THREADS -v -v -v -v -f $ENSUREPIAL -j $JOINTHRESHOLD $USEFASTCOLLISION $DEBUGWHITE $DEBUGPIAL -d -d -d 2>&1 | tee -a logs/$SUBJID.log
fi
# cleanup this marker, just in case
rm -f SurfReconDeformable/${SUBJID}/temp/white_rerun_required
#RECONRETURNCODE=${PIPESTATUS[0]}
#echo $RECONRETURNCODE
# rerun, merge required
if [ -f "SurfReconDeformable/${SUBJID}/temp/merge_required" ]
then
	echo "Merge required, rerunning"
	rm -f SurfReconDeformable/${SUBJID}/temp/merge_required
	touch SurfReconDeformable/${SUBJID}/temp/second_run
	recon-neonatal-cortex -r `pwd` -c $CONFIGFILE -s $SUBJID -t $OMP_NUM_THREADS -v -v -v -v -f $ENSUREPIAL -j $JOINTHRESHOLD $USEFASTCOLLISION $DEBUGWHITE $DEBUGPIAL -d -d -d 2>&1 | tee -a logs/$SUBJID.log
fi


#RECONRETURNCODE=${PIPESTATUS[0]}

# if [ "$RECONRETURNCODE" != "0" ]
# then
# 	exit
# 	CEREBRUMERROR1=`tac logs/$SUBJID.log | sed '/[^[:blank:]]/q;d' | grep -Po -e "\s*Exception: Failed to resolve self-intersections of .+/cerebrum-1.vtp\s*$"`
# 	CEREBRUMERROR2=`tac logs/$SUBJID.log | sed '/[^[:blank:]]/q;d' | grep -Po -e "^Exception: Merged surface is non-closed, no. of boundaries"`

# 	if [ ! -z "$CEREBRUMERROR1" -o ! -z "$CEREBRUMERROR2" ]
# 	then
# 		echo "Initial cerebrum closing failed, restarting with larger structuring elements for subdivide-brain-image"

# 		T=`mktemp`
# 		cp $CONFIGFILE $T
# 		sed -i -e 's/subcortex_closing  = 5/subcortex_closing  = 15/' $T
# 		sed -i -e 's/brainstem_closing  = 5/brainstem_closing  = 15/' $T
# 		sed -i -e 's/cerebellum_closing = 5/cerebellum_closing = 15/' $T

# 		find SurfReconDeformable/$SUBJID -type f -delete
# 		recon-neonatal-cortex -r `pwd` -c $T -s $SUBJID -t $OMP_NUM_THREADS -v -v -v -v -d -d -f -ensure-pial-is-outside-white-surface -j $J $USEFASTCOLLISION 2>&1 | tee -a logs/$SUBJID.log
# 		SECONDRECONRETURNCODE=${PIPESTATUS[0]}
# 		rm -f $T
# 	fi
# fi

OUTDIR=SurfReconDeformable
if [ "$RECONRETURNCODE" == "0" -o "$SECONDRECONRETURNCODE" == "0" -o "1" == "1" ]
then
	echo "making freesurfer surfaces"
	HEMIS="lh
	rh"

	SURFS="white
	pial"

	mkdir -p freesurfer/$SUBJID/surf
	mkdir -p freesurfer/$SUBJID/label

	# if [ "$USEBONNIE" == "YES" ]
	# then
	# 	VOLGEOM=TissueSegMCRIBS/${SUBJID}_t2w_restore.nii.gz
	# else
	# 	#VOLGEOM=/$SUBJID.nii.gz
	# 	VOLGEOM=TissueSeg/${SUBJID}_t2w_restore.nii.gz
	# fi
	VOLGEOM=TissueSegMCRIBS/${SUBJID}/${SUBJID}_t2w_restore.nii.gz
	#echo $VOLGEOM
	for HEMI in $HEMIS
	do
		for SURF in $SURFS
		do
			
			#`dirname $0`/../VTK/VTK-install/bin/vtkpython `dirname $0`/VTPExtractSurfs --tkr-only --surf-volgeom=$VOLGEOM $OUTDIR/$SUBJID/meshes/$SURF-$HEMI.vtp
			$MCRIBS_HOME/VTK/VTK-install/bin/vtkpython $MCRIBS_HOME/bin/VTPExtractSurfs --tkr-only --surf-volgeom=$VOLGEOM $OUTDIR/$SUBJID/meshes/$SURF-$HEMI.vtp
			#rm -f $OUTDIR/$SUBJID/meshes/${SURF}-${HEMI}_world.surf
			mv $OUTDIR/$SUBJID/meshes/${SURF}-${HEMI}_tkr.surf freesurfer/$SUBJID/surf/$HEMI.$SURF

		done
		#`dirname $0`/../VTK/VTK-install/bin/vtkpython `dirname $0`/VTPCortexMaskToLabel SurfReconDeformable/$SUBJID/meshes/white-${HEMI}.vtp freesurfer/$SUBJID/surf/$HEMI.white freesurfer/$SUBJID/label/$HEMI.cortex.label
		$MCRIBS_HOME/VTK/VTK-install/bin/vtkpython $MCRIBS_HOME/bin/VTPCortexMaskToLabel SurfReconDeformable/$SUBJID/meshes/white-${HEMI}.vtp freesurfer/$SUBJID/surf/$HEMI.white freesurfer/$SUBJID/label/$HEMI.cortex.label
	done

	# make the pial surfaces by reordering the pial vertices in the VTP files
	#`dirname $0`/../VTK/VTK-install/bin/vtkpython `dirname $0`/DeformableReorderVertices --surf-volgeom=$VOLGEOM $OUTDIR/$SUBJID freesurfer/$SUBJID/surf
	$MCRIBS_HOME/VTK/VTK-install/bin/vtkpython $MCRIBS_HOME/bin/DeformableReorderVertices --surf-volgeom=$VOLGEOM $OUTDIR/$SUBJID freesurfer/$SUBJID/surf

	# cleanup
	#rm -f $OUTDIR/$SUBJID/temp/*hull* $OUTDIR/$SUBJID/temp/wm.nii.gz $OUTDIR/$SUBJID/temp/*iso*.vtp $OUTDIR/$SUBJID/temp/*mask*.nii.gz $OUTDIR/$SUBJID/temp/*dmap*.nii.gz $OUTDIR/$SUBJID/temp/*mask*.nii.gz
fi
